[Unit]
Description=PulseCity API
After=network-online.target
Wants=network-online.target

[Service]
User=pulsecity
WorkingDirectory=/opt/pulsecity/backend
EnvironmentFile=/opt/pulsecity/backend/.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3
StandardOutput=append:/var/log/pulsecity/app.log
StandardError=append:/var/log/pulsecity/app.log
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
