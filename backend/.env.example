NODE_ENV=development
PORT=4000
AWS_REGION=ap-south-1

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
PHOTO_BUCKET=pulsecity-photos-ACCOUNT-REGION
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:ACCOUNT:pulsecity-alerts

# Optional: when set, priority is scored by Lambda (falls back to local rules on error)
PRIORITY_LAMBDA=pulsecity-priority
USERS_TABLE=pulsecity-users
INCIDENTS_TABLE=pulsecity-incidents
HISTORY_TABLE=pulsecity-history

# Used by infra/provision.sh only (the app ignores them)
ALERT_EMAIL=you@example.com
APP_ORIGIN=http://localhost:4000

# Role self-signup codes. Leave blank to keep that role invite-only (admin creates it in-app).
STAFF_SIGNUP_CODE=
SUPERVISOR_SIGNUP_CODE=
ADMIN_SIGNUP_CODE=